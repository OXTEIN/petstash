n": "Wolpertinger", "r": "common", "t": "https://cdn.playadopt.me/items/wolpertinger.png"}, {"n": "Wood Pigeon", "r": "ultra_rare", "t": "https://cdn.playadopt.me/items/springfest_2023_wood_pigeon.png"}, {"n": "Woodland Egg", "r": "legendary", "t": "https://cdn.playadopt.me/items/woodland_2022_woodland_egg.png"}, {"n": "Woodpecker", "r": "rare", "t": "https://cdn.playadopt.me/items/woodland_2022_woodpecker.png"}, {"n": "Woolly Mammoth", "r": "rare", "t": "https://cdn.playadopt.me/items/woolly_mammoth.png"}, {"n": "Woolly Rhino", "r": "ultra_rare", "t": "https://cdn.playadopt.me/items/winter_2022_wooly_rhino.png"}, {"n": "Wrapped Doll", "r": "legendary", "t": "https://cdn.playadopt.me/items/dolls_2023_wrapped_doll.png"}, {"n": "Wren", "r": "rare", "t": "https://cdn.playadopt.me/items/summerfest_2025_wren.png"}, {"n": "Wyvern", "r": "ultra_rare", "t": "https://cdn.playadopt.me/items/wyvern.png"}, {"n": "Yellow Butterfly", "r": "rare", "t": "https://cdn.playadopt.me/items/sanctuary_2022_yellow_bucks_butterfly.png"}, {"n": "Yellow-lipped Sea Krait", "r": "uncommon", "t": "https://cdn.playadopt.me/items/seasia_2023_yellow_lipped_sea_krait.png"}, {"n": "Yeti", "r": "ultra_rare", "t": "https://cdn.playadopt.me/items/yeti.png"}, {"n": "Yule Log Dog", "r": "legendary", "t": "https://cdn.playadopt.me/items/april_fools_2023_yule_log_dog.png"}, {"n": "Zebra", "r": "rare", "t": "https://cdn.playadopt.me/items/basic_egg_2022_zebra.png"}, {"n": "Zeopod", "r": "rare", "t": "https://cdn.playadopt.me/items/moon_2025_zeopod.png"}, {"n": "Zodiac Minion Chick", "r": "legendary", "t": "https://cdn.playadopt.me/items/gru_2022_zodiac_chick.png"}, {"n": "Zodiac Minion Egg", "r": "legendary", "t": "https://cdn.playadopt.me/items/gru_2022_zodiac_egg.png"}, {"n": "Zombie Buffalo", "r": "ultra_rare", "t": "https://cdn.playadopt.me/items/zombie_buffalo.png"}, {"n": "Zombie Chick", "r": "rare", "t": "https://cdn.playadopt.me/items/halloween_2024_zombie_chick.png"}, {"n": "Zombie Wolf", "r": "ultra_rare", "t": "https://cdn.playadopt.me/items/halloween_2022_zombie_wolf.png"}];
const RARITY_ORDER = ["common","uncommon","rare","ultra_rare","legendary"];
const RARITY_LABEL = {common:"Common",uncommon:"Uncommon",rare:"Rare",ultra_rare:"Ultra-Rare",legendary:"Legendary"};
const RARITY_COLOR = {common:"#8aa0b8",uncommon:"#3fb96a",rare:"#3a8be0",ultra_rare:"#a25ce6",legendary:"#f0a51e"};

const LS_COUNTS="am_counts_v2", LS_FOLIOS="am_folios_v1", LS_FITEMS="am_folioitems_v1",
      LS_VAR="am_var_v1", LS_UI="am_ui_v2", LS_THEME="am_theme_v1";
const ELDORADO_URL="https://www.eldorado.gg/adopt-me-pets/i/201-2-0";

function loadLS(k,d){ try{const v=localStorage.getItem(k);return v?JSON.parse(v):d;}catch(e){return d;} }
function saveLS(k,v){ try{localStorage.setItem(k,JSON.stringify(v));}catch(e){} }

let counts=loadLS(LS_COUNTS,{});            // {petName: number}
let folios=loadLS(LS_FOLIOS,[]);            // [{id,name}]
let fitems=loadLS(LS_FITEMS,{});            // {folioId:{petName:true}}
let variant=loadLS(LS_VAR,{N:false,M:false,F:false,R:false});
let ui=loadLS(LS_UI,{});

function countOf(k){ return counts[k]||0; }
function isOwned(k){ return countOf(k)>0; }
function inFolio(fid,k){ return !!(fitems[fid] && fitems[fid][k]); }
function petFolioCount(k){ let n=0; for(const f of folios){ if(inFolio(f.id,k)) n++; } return n; }

/* ---------- theme ---------- */
const themeBtn=document.getElementById('themeBtn');
let theme=loadLS(LS_THEME,"auto");
function systemDark(){ return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches; }
function isDark(){ return theme==="dark" || (theme==="auto" && systemDark()); }
function applyTheme(){
  const root=document.documentElement;
  if(theme==="auto") root.removeAttribute('data-theme'); else root.setAttribute('data-theme',theme);
  themeBtn.textContent = isDark() ? "☀️" : "🌙";
}
themeBtn.addEventListener('click',()=>{ theme=isDark()?"light":"dark"; saveLS(LS_THEME,theme); applyTheme(); });
if(window.matchMedia){ try{ window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{ if(theme==="auto") applyTheme(); }); }catch(e){} }
applyTheme();

/* ---------- state ---------- */
let mode = ui.mode==="prices" ? "prices":"collection";
let filterR = ui.filterR || "all";
let query = ui.query || "";
let sortMode = (ui.sortMode==="name-asc") ? "name-asc" : "rarity-desc";
let ownFilter = ["owned","missing"].includes(ui.ownFilter) ? ui.ownFilter : "all";
let folioFilter = ui.folioFilter || null;   // folio id or null (All pets)
if(folioFilter && !folios.some(f=>f.id===folioFilter)) folioFilter=null;
function saveUI(){ saveLS(LS_UI,{mode,filterR,query,sortMode,ownFilter,folioFilter}); }

function allPets(){ return BASE_PETS.map(p=>({key:p.n,n:p.n,r:p.r,t:p.t})); }

/* ---------- refs ---------- */
const grid=document.getElementById('grid');
const emptyEl=document.getElementById('empty');
const sentinel=document.getElementById('sentinel');
const ownSeg=document.getElementById('ownSeg');

/* ---------- filter / sort ---------- */
function petMatches(p){
  if(filterR!=="all" && p.r!==filterR) return false;
  if(ownFilter==="missing" && isOwned(p.key)) return false;
  if(ownFilter==="owned" && !isOwned(p.key)) return false;
  if(folioFilter && !inFolio(folioFilter,p.key)) return false;
  if(query && !p.n.toLowerCase().includes(query)) return false;
  return true;
}
function sortPets(arr){
  const byName=(a,b)=>a.n.toLowerCase().localeCompare(b.n.toLowerCase());
  const rIdx=p=>RARITY_ORDER.indexOf(p.r);
  if(sortMode==="name-asc") arr.sort(byName);
  else arr.sort((a,b)=>rIdx(b)-rIdx(a)||byName(a,b));
  return arr;
}

/* ---------- lazy rendering ---------- */
let currentList=[], renderedCount=0;
const BATCH=120;

function makeCard(p){
  const el=document.createElement('div');
  el.className="pet";
  el.dataset.owned=isOwned(p.key)?"1":"0";
  el.dataset.infolio=petFolioCount(p.key)>0?"1":"0";
  el.dataset.key=p.key;
  const img=p.t
    ? `<img src="${escapeAttr(p.t)}" alt="" loading="lazy" onerror="this.parentNode.innerHTML='<div class=&quot;noimg&quot;>🐾</div>'">`
    : `<div class="noimg">🐾</div>`;
  el.innerHTML=`
    <button class="tagbtn" title="Add to lists">🏷</button>
    <div class="check">✓</div>
    <div class="imgwrap">${img}</div>
    <div class="pname">${escapeHtml(p.n)}</div>
    <span class="rtag" data-r="${p.r}">${RARITY_LABEL[p.r]||p.r}</span>
    <div class="stepper">
      <button class="minus" title="Remove one">−</button>
      <span class="qty">×${countOf(p.key)}</span>
      <button class="plus" title="Add one">+</button>
    </div>
    <button class="price-btn"></button>
  `;
  return el;
}
function render(){
  currentList=sortPets(allPets().filter(petMatches));
  document.getElementById('shown').textContent=currentList.length;
  emptyEl.style.display=currentList.length?"none":"block";
  grid.innerHTML=""; renderedCount=0;
  renderMore(); updateProgress();
}
function renderMore(){
  const slice=currentList.slice(renderedCount,renderedCount+BATCH);
  const frag=document.createDocumentFragment();
  for(const p of slice) frag.appendChild(makeCard(p));
  grid.appendChild(frag);
  renderedCount+=slice.length;
  updatePriceButtons();
}
const io=new IntersectionObserver((es)=>{ if(es[0].isIntersecting && renderedCount<currentList.length) renderMore(); },{rootMargin:"800px"});
io.observe(sentinel);

function updateProgress(){
  const pets=allPets();
  const total=pets.length;
  let ownedN=0, copies=0;
  const perR={}; RARITY_ORDER.forEach(r=>perR[r]={o:0,t:0});
  for(const p of pets){
    if(!perR[p.r]) perR[p.r]={o:0,t:0};
    perR[p.r].t++;
    const c=countOf(p.key);
    if(c>0){ ownedN++; perR[p.r].o++; copies+=c; }
  }
  document.getElementById('ownedCount').textContent=ownedN;
  document.getElementById('totalCount').textContent=total;
  document.getElementById('copies').textContent = copies>ownedN ? ("· "+copies+" copies total") : "";
  const pct=total?Math.round(ownedN/total*100):0;
  document.getElementById('pctText').textContent=pct+" %";
  document.getElementById('barFill').style.width=pct+"%";
  document.getElementById('rarMini').innerHTML=RARITY_ORDER.map(r=>
    `<span class="chipstat"><span class="dot" style="background:${RARITY_COLOR[r]}"></span>${RARITY_LABEL[r]}: ${perR[r].o}/${perR[r].t}</span>`).join("");
  document.querySelectorAll('.chip').forEach(c=>{
    const r=c.dataset.r;
    const n=r==="all"?total:(perR[r]?perR[r].t:0);
    const nn=c.querySelector('.n'); if(nn) nn.textContent=n;
  });
}

function updatePriceButtons(){
  const code=variantCode();
  const label=code?('💰 Prices · '+code+' →'):'💰 Prices on Eldorado →';
  grid.querySelectorAll('.price-btn').forEach(b=>b.textContent=label);
}

/* ---------- counts ---------- */
function setCount(key,c,cardEl){
  if(c<=0){ delete counts[key]; } else { counts[key]=c; }
  saveLS(LS_COUNTS,counts);
  if(cardEl){
    cardEl.dataset.owned=isOwned(key)?"1":"0";
    const q=cardEl.querySelector('.qty'); if(q) q.textContent="×"+countOf(key);
  }
  updateProgress();
  // if a filter hides/shows this pet based on owned status, re-render
  if(ownFilter!=="all") render();
}
function inc(key,cardEl){ setCount(key,countOf(key)+1,cardEl); }
function dec(key,cardEl){ setCount(key,countOf(key)-1,cardEl); }

/* ---------- rarity chips ---------- */
function buildChips(){
  const chips=document.getElementById('chips');
  const defs=[["all","All"]].concat(RARITY_ORDER.map(r=>[r,RARITY_LABEL[r]]));
  chips.innerHTML=defs.map(([r,label])=>`<button class="chip" data-r="${r}" data-active="${r===filterR?1:0}">${label}<span class="n"></span></button>`).join("");
  chips.querySelectorAll('.chip').forEach(c=>{
    c.addEventListener('click',()=>{
      filterR=c.dataset.r;
      chips.querySelectorAll('.chip').forEach(x=>x.dataset.active=x===c?"1":"0");
      saveUI(); render();
    });
  });
}

/* ---------- portfolios ---------- */
function newId(){ return "f"+Date.now()+Math.floor(Math.random()*999); }
function buildFolios(){
  const bar=document.getElementById('folios');
  let html=`<button class="folio" data-f="__all" data-active="${folioFilter?0:1}">All pets</button>`;
  for(const f of folios){
    const cnt=fitems[f.id]?Object.keys(fitems[f.id]).length:0;
    html+=`<button class="folio" data-f="${f.id}" data-active="${folioFilter===f.id?1:0}">${escapeHtml(f.name)}<span class="fc">${cnt}</span></button>`;
  }
  html+=`<button class="folio-new" id="folioNew">+ New list</button>`;
  if(folioFilter){ html+=`<button class="folio-edit" id="folioRename">✎ rename</button><button class="folio-edit" id="folioDelete">🗑 delete</button>`; }
  bar.innerHTML=html;
  bar.querySelectorAll('.folio').forEach(b=>{
    b.addEventListener('click',()=>{
      folioFilter = b.dataset.f==="__all" ? null : b.dataset.f;
      saveUI(); buildFolios(); render();
    });
  });
  const nb=document.getElementById('folioNew');
  nb.addEventListener('click',()=>{
    const name=(prompt("Name your new list (e.g. FOR TRADE):")||"").trim();
    if(!name) return;
    const id=newId(); folios.push({id,name}); fitems[id]={};
    saveLS(LS_FOLIOS,folios); saveLS(LS_FITEMS,fitems);
    folioFilter=id; saveUI(); buildFolios(); render();
  });
  const rn=document.getElementById('folioRename');
  if(rn) rn.addEventListener('click',()=>{
    const f=folios.find(x=>x.id===folioFilter); if(!f) return;
    const name=(prompt("Rename list:",f.name)||"").trim();
    if(name){ f.name=name; saveLS(LS_FOLIOS,folios); buildFolios(); }
  });
  const dl=document.getElementById('folioDelete');
  if(dl) dl.addEventListener('click',()=>{
    const f=folios.find(x=>x.id===folioFilter); if(!f) return;
    if(!confirm('Delete list "'+f.name+'"? (Pets stay in your collection, just not in this list.)')) return;
    folios=folios.filter(x=>x.id!==folioFilter); delete fitems[folioFilter];
    saveLS(LS_FOLIOS,folios); saveLS(LS_FITEMS,fitems);
    folioFilter=null; saveUI(); buildFolios(); render();
  });
}

/* ---------- lists modal ---------- */
const listModalBg=document.getElementById('listModalBg');
let listPet=null;
function openLists(key){
  listPet=key;
  document.getElementById('listModalTitle').textContent='Add "'+key+'" to lists';
  renderListChoices();
  listModalBg.dataset.open="1";
}
function closeLists(){
  listModalBg.dataset.open="0";
  document.getElementById('newFolioName').value="";
  buildFolios();
  render();  // membership may affect current folio view + tag badges
}
function renderListChoices(){
  const box=document.getElementById('listChoices');
  if(folios.length===0){ box.innerHTML='<span class="hint">No lists yet — create one below 👇</span>'; return; }
  box.innerHTML=folios.map(f=>`<button class="choice" data-fid="${f.id}" data-active="${inFolio(f.id,listPet)?1:0}">${escapeHtml(f.name)}</button>`).join("");
  box.querySelectorAll('.choice').forEach(c=>{
    c.addEventListener('click',()=>{
      const fid=c.dataset.fid;
      if(!fitems[fid]) fitems[fid]={};
      if(fitems[fid][listPet]) delete fitems[fid][listPet]; else fitems[fid][listPet]=true;
      saveLS(LS_FITEMS,fitems);
      c.dataset.active=inFolio(fid,listPet)?"1":"0";
    });
  });
}
document.getElementById('newFolioBtn').addEventListener('click',()=>{
  const name=document.getElementById('newFolioName').value.trim();
  if(!name) return;
  const id=newId(); folios.push({id,name}); fitems[id]={};
  if(listPet) fitems[id][listPet]=true;
  saveLS(LS_FOLIOS,folios); saveLS(LS_FITEMS,fitems);
  document.getElementById('newFolioName').value="";
  renderListChoices();
});
document.getElementById('listDone').addEventListener('click',closeLists);
listModalBg.addEventListener('click',e=>{ if(e.target===listModalBg) closeLists(); });

/* ---------- variant ---------- */
function variantCode(){ const neon=variant.M?"M":(variant.N?"N":""); return neon+(variant.F?"F":"")+(variant.R?"R":""); }
function refreshVarChips(){
  document.querySelectorAll('.vchip').forEach(c=>c.dataset.active=variant[c.dataset.v]?"1":"0");
  const code=variantCode();
  document.getElementById('vchips').dataset.any=code?"1":"0";
  document.getElementById('vcode').textContent="→ "+code;
  updatePriceButtons();
}
document.querySelectorAll('.vchip').forEach(c=>{
  c.addEventListener('click',()=>{
    const v=c.dataset.v; variant[v]=!variant[v];
    if(v==="N"&&variant.N)variant.M=false;
    if(v==="M"&&variant.M)variant.N=false;
    saveLS(LS_VAR,variant); refreshVarChips();
  });
});
document.getElementById('vclear').addEventListener('click',()=>{ variant={N:false,M:false,F:false,R:false}; saveLS(LS_VAR,variant); refreshVarChips(); });
document.querySelectorAll('.vpreset').forEach(b=>{
  b.addEventListener('click',()=>{
    const p=b.dataset.p;
    variant={N:p==="NFR", M:p==="MFR", F:p.includes("F"), R:p.includes("R")};
    saveLS(LS_VAR,variant); refreshVarChips();
  });
});

/* ---------- grid click ---------- */
grid.addEventListener('click',(e)=>{
  const card=e.target.closest('.pet'); if(!card) return;
  const key=card.dataset.key;
  if(e.target.closest('.tagbtn')){ e.stopPropagation(); openLists(key); return; }
  if(e.target.closest('.minus')){ e.stopPropagation(); dec(key,card); return; }
  if(e.target.closest('.plus')){ e.stopPropagation(); inc(key,card); return; }
  if(mode==="prices"){ openEldorado(card.querySelector('.pname').textContent); return; }
  inc(key,card); // click anywhere on the card = +1
});

/* ---------- controls ---------- */
document.getElementById('search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();saveUI();render();});
document.getElementById('sort').addEventListener('change',e=>{sortMode=e.target.value;saveUI();render();});
ownSeg.querySelectorAll('button').forEach(b=>{
  b.addEventListener('click',()=>{
    ownFilter=b.dataset.o;
    ownSeg.querySelectorAll('button').forEach(x=>x.dataset.active=x===b?"1":"0");
    saveUI(); render();
  });
});

/* ---------- mode ---------- */
const btnCol=document.getElementById('modeCollection');
const btnPri=document.getElementById('modePrices');
function setMode(m){
  mode=m; document.body.dataset.mode=m;
  btnCol.dataset.active=m==="collection"?"1":"0";
  btnPri.dataset.active=m==="prices"?"1":"0";
  saveUI();
}
btnCol.addEventListener('click',()=>setMode("collection"));
btnPri.addEventListener('click',()=>setMode("prices"));

/* ---------- eldorado + toast ---------- */
let toastT=null;
function toast(msg){ const el=document.getElementById('toast'); el.textContent=msg; el.dataset.show="1"; clearTimeout(toastT); toastT=setTimeout(()=>el.dataset.show="0",2600); }
function openEldorado(name){
  const code=variantCode();
  const q=code?(name+" "+code):name;
  const url=ELDORADO_URL+"?searchQuery="+encodeURIComponent(q);
  toast('💰 Opening prices for "'+q+'" on Eldorado');
  window.open(url,'_blank','noopener');
}

/* ---------- backup ---------- */
function collectSave(){ return {app:"stashio", v:2, date:new Date().toISOString(), counts, folios, fitems, variant}; }
document.getElementById('exportBtn').addEventListener('click',()=>{
  const blob=new Blob([JSON.stringify(collectSave(),null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob); a.download='stashio-backup.json';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href),1500);
  toast('⬇️ Backup downloaded');
});
const importFile=document.getElementById('importFile');
document.getElementById('importBtn').addEventListener('click',()=>importFile.click());
importFile.addEventListener('change',e=>{
  const f=e.target.files[0]; if(!f) return;
  const rd=new FileReader();
  rd.onload=()=>{
    try{
      const d=JSON.parse(rd.result);
      if(!d || typeof d!=="object") throw new Error("bad");
      if(!confirm('Load backup? This will overwrite your current collection and lists.')){ importFile.value=""; return; }
      if(d.counts && typeof d.counts==="object"){ counts=d.counts; }
      else if(Array.isArray(d.owned)){ counts={}; d.owned.forEach(k=>counts[k]=1); } // old format
      else counts={};
      folios=Array.isArray(d.folios)?d.folios:[];
      fitems=(d.fitems&&typeof d.fitems==="object")?d.fitems:{};
      variant=(d.variant&&typeof d.variant==="object")?{N:!!d.variant.N,M:!!d.variant.M,F:!!d.variant.F,R:!!d.variant.R}:{N:false,M:false,F:false,R:false};
      saveLS(LS_COUNTS,counts); saveLS(LS_FOLIOS,folios); saveLS(LS_FITEMS,fitems); saveLS(LS_VAR,variant);
      folioFilter=null; saveUI();
      refreshVarChips(); buildFolios(); render();
      toast('✅ Backup loaded');
    }catch(err){ toast("❌ This file doesn't look like a backup"); }
    importFile.value="";
  };
  rd.readAsText(f);
});

/* ---------- reset ---------- */
document.getElementById('resetLink').addEventListener('click',e=>{
  e.preventDefault();
  if(confirm("Really clear everything — counts and lists? (Better download a backup first.)")){
    counts={}; folios=[]; fitems={}; folioFilter=null;
    saveLS(LS_COUNTS,counts); saveLS(LS_FOLIOS,folios); saveLS(LS_FITEMS,fitems); saveUI();
    buildChips(); buildFolios(); render();
  }
});

/* ---------- utils ---------- */
function escapeHtml(s){ return String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }
function escapeAttr(s){ return String(s).replace(/["&<>]/g,c=>({'"':'&quot;','&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }

/* ---------- apply saved UI ---------- */
document.getElementById('search').value=query;
document.getElementById('sort').value=sortMode;
ownSeg.querySelectorAll('button').forEach(x=>x.dataset.active=x.dataset.o===ownFilter?"1":"0");

/* ---------- init ---------- */
setMode(mode);
buildChips();
buildFolios();
refreshVarChips();
render();
</script>
</body>
</html>
